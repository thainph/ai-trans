{
  "name": "context-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension (MV3): AI Translator + Web to Markdown + Slack Thread Exporter",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
