{
  "name": "context-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension (MV3): AI Translator + Web to Markdown + Slack Thread Exporter",
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && vite build && vite build -c vite.content.config.ts --mode all-frames && vite build -c vite.content.config.ts --mode slack && pnpm check:dist",
    "dev": "pnpm dev:all",
    "dev:all": "pnpm run \"/^dev:(main|content|slack)$/\"",
    "dev:main": "vite build --watch --minify false",
    "dev:content": "vite build -c vite.content.config.ts --mode all-frames --watch --minify false",
    "dev:slack": "vite build -c vite.content.config.ts --mode slack --watch --minify false",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "lint:ci": "biome ci --error-on-warnings .",
    "format": "biome check --write .",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/chrome": "^0.3.4",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
